# Copy this file to application.properties and fill in your values
# DO NOT commit application.properties to Git!

# --- 1. Configuration Serveur ---
server.port=5000

# --- 2. Base de Données PostgreSQL ---
spring.datasource.url=jdbc:postgresql://YOUR_HOST:5432/YOUR_DB_NAME
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=update
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# --- 3. Configuration Blockchain ---
web3j.client-address=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
blockchain.contract.address=0xYOUR_CONTRACT_ADDRESS
blockchain.admin.private-key=0xYOUR_ADMIN_PRIVATE_KEY
admin.wallet.address=0xYOUR_ADMIN_WALLET_ADDRESS

# --- 4. Stockage Fichiers ---
file.upload-dir=./uploads/diplomas
